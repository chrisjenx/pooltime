---
source: tests/it/service.rs
expression: "render_launchd_plist(Path::new(\"/usr/local/bin/pooltime\"), &fake_paths())"
---
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.pooltime.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/pooltime</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>POOLTIME_HOME</key>
    <string>/Users/test/.pooltime</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>/Users/test/.pooltime/logs/daemon.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/test/.pooltime/logs/daemon.err</string>
</dict>
</plist>
